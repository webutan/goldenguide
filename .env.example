# Copy this file to .env and fill in real values before running docker compose.

# Strong password for the PostgreSQL database
DB_PASSWORD=changeme

# Port the app is exposed on your NAS (your reverse proxy forwards here)
APP_PORT=8080

# Password required to enable admin mode in the UI
ADMIN_PASSWORD=changeme

# Allowed CORS origin for the frontend (e.g. your Cloudflare tunnel URL).
# Defaults to '*' (dev-friendly) if not set.
CORS_ORIGIN=https://your-tunnel.trycloudflare.com

# X/Twitter API v2 bearer token for the Feed app's tweet refresh job.
# Leave empty to disable the feed refresh (the feed then shows no tweets).
TWITTER_BEARER_TOKEN=

# Public address of the site, e.g. https://goldengai.example.com (no trailing
# slash). Used for the absolute URLs in link previews (og:url, og:image),
# canonical links, sitemap.xml and robots.txt. If empty, the address is taken
# from each request (Host + X-Forwarded-Proto), which is only right when the
# proxy in front forwards both correctly. Set it.
PUBLIC_URL=

# Where the API fetches the built index.html that it adds per-bar <head> tags
# to. The default (the web container) is right for docker compose.
# SPA_TEMPLATE_URL=http://web/index.html
